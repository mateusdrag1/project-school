    "test:watch": "jest --watchAll --runInBand",
    "db:migrate": "tsx --env-file=.env src/lib/typeorm/run-migrations.ts",
    "db:revert": "tsx --env-file=.env src/lib/typeorm/revert-migrations.ts",
    "db:seed": "tsx --env-file=.env src/lib/typeorm/seed.ts"
  },
